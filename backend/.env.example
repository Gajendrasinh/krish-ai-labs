# Copy to .env and fill in. Never commit the real .env file.

# Required for real AI answers. Without this, the backend runs in
# retrieval-only mode (see app/agent.py) — it still answers from the
# knowledge base, just without an LLM generating the response.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API (the website
# origin, the mobile app's dev origin, etc). Defaults to "*" (open) if unset —
# tighten this before deploying.
ALLOWED_ORIGINS=*

# Port the server listens on when run via `python -m uvicorn` locally.
PORT=8000
